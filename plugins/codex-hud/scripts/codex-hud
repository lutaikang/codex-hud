#!/usr/bin/env python3
"""Enable, disable, and launch Codex with a local tmux HUD."""

from __future__ import annotations

import argparse
import os
import secrets
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

from hud_state import enabled, hud_home, mark_ended, remove_run, set_enabled, HUD_LINES


SCRIPT_DIR = Path(__file__).resolve().parent
RENDERER = SCRIPT_DIR / "hud_render.py"


def _best_effort(action: object, *arguments: object, **keywords: object) -> None:
    try:
        action(*arguments, **keywords)  # type: ignore[operator]
    except Exception:
        # Cleanup must continue even if local telemetry or tmux already vanished.
        pass


def _mark_ended(run_id: str) -> None:
    _best_effort(mark_ended, run_id)


def _remove_run(run_id: str) -> None:
    _best_effort(remove_run, run_id)


def _unlink(path: Path) -> None:
    _best_effort(path.unlink, missing_ok=True)


def _kill_tmux(target_type: str, target: str) -> None:
    _best_effort(
        subprocess.run,
        ["tmux", f"kill-{target_type}", "-t", target],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def _tmux_session_exists(session_name: str) -> bool:
    try:
        result = subprocess.run(
            ["tmux", "has-session", "-t", session_name],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return result.returncode == 0


def _write_private_text(path: Path, text: str) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, name = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    temporary = Path(name)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.replace(temporary, path)
    finally:
        _unlink(temporary)


def _require(command: str) -> str:
    path = shutil.which(command)
    if path is None:
        raise SystemExit(f"缺少依赖：{command}")
    return path


def _command_text(arguments: list[str]) -> str:
    return shlex.join(arguments)


def _tmux_command(arguments: list[str], environment: dict[str, str]) -> str:
    """Build a pane command with the caller's account-scoping environment."""
    prefix = [
        "env",
        "-u",
        "CODEX_HOME",
        "-u",
        "CODEX_HUD_HOME",
        "-u",
        "CODEX_HUD_RUN_ID",
    ]
    for key in ("CODEX_HOME", "CODEX_HUD_HOME", "PATH"):
        value = environment.get(key)
        if value is not None:
            prefix.append(f"{key}={value}")
    return _command_text([*prefix, *arguments])


def launch(arguments: list[str]) -> int:
    _require("codex")
    _require("tmux")
    if not enabled():
        return subprocess.call(["codex", *arguments])

    run_id = f"{int(time.time())}-{os.getpid()}-{secrets.token_hex(3)}"
    environment = os.environ.copy()
    environment["CODEX_HUD_RUN_ID"] = run_id
    hud_command = _tmux_command(
        [sys.executable, str(RENDERER), "--run-id", run_id], environment
    )

    if environment.get("TMUX") and environment.get("TMUX_PANE"):
        current_pane = environment["TMUX_PANE"]
        result = subprocess.run(
            [
                "tmux",
                "split-window",
                "-v",
                "-l",
                str(HUD_LINES),
                "-t",
                current_pane,
                "-P",
                "-F",
                "#{pane_id}",
                hud_command,
            ],
            capture_output=True,
            text=True,
            check=True,
        )
        hud_pane = result.stdout.strip()
        # Mark the HUD pane so scroll-wheel bindings can identify it.
        subprocess.run(
            ["tmux", "set-option", "-p", "-t", hud_pane, "@is_hud", "1"],
            check=False,
        )
        # Enable mouse at window level so tmux intercepts scroll events.
        subprocess.run(
            ["tmux", "set-option", "-w", "mouse", "on"],
            check=False,
        )
        # HUD pane must not capture the scroll wheel: when the pane under
        # the cursor carries @is_hud the event is silently dropped;
        # otherwise tmux enters copy-mode so the user can scroll history.
        subprocess.run(
            [
                "tmux", "bind-key", "-T", "root", "WheelUpPane",
                "if-shell", "-F", "-t", "=",
                "#{e|!=:#{@is_hud},1}",
                "copy-mode -e",
            ],
            check=False,
        )
        subprocess.run(["tmux", "select-pane", "-t", current_pane], check=False)
        try:
            return subprocess.call(["codex", *arguments], env=environment)
        finally:
            _mark_ended(run_id)
            _kill_tmux("pane", hud_pane)
            _remove_run(run_id)

    session_name = f"codex-hud-{int(time.time())}-{os.getpid()}"
    ready_path = hud_home() / "runs" / f".{run_id}.ready"
    exit_path = hud_home() / "runs" / f".{run_id}.exit"
    detached_path = hud_home() / "runs" / f".{run_id}.detached"
    ready_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    _unlink(ready_path)
    _unlink(exit_path)
    _unlink(detached_path)
    main_command = _tmux_command(
        [
            sys.executable,
            str(Path(__file__).resolve()),
            "_run-main",
            "--session",
            session_name,
            "--run-id",
            run_id,
            "--ready-file",
            str(ready_path),
            "--exit-file",
            str(exit_path),
            "--detached-file",
            str(detached_path),
            "--",
            *arguments,
        ],
        environment,
    )
    term_size = shutil.get_terminal_size((120, 24))
    created = subprocess.run(
        [
            "tmux",
            "new-session",
            "-d",
            "-x", str(term_size.columns),
            "-y", str(term_size.lines),
            "-P",
            "-F",
            "#{pane_id}",
            "-s",
            session_name,
            "-c",
            os.getcwd(),
            main_command,
        ],
        capture_output=True,
        text=True,
        check=True,
    )
    main_pane = created.stdout.strip()
    layout_ready = False
    try:
        # This session belongs to the HUD wrapper, so its own tmux status bar is
        # redundant. Enable mouse so the user can scroll the Codex pane history.
        subprocess.run(
            ["tmux", "set-option", "-t", session_name, "status", "off"],
            check=False,
        )
        subprocess.run(
            ["tmux", "set-option", "-t", session_name, "mouse", "on"],
            check=False,
        )
        result = subprocess.run(
            [
                "tmux",
                "split-window",
                "-v",
                "-l",
                str(HUD_LINES),
                "-t",
                main_pane,
                "-c",
                os.getcwd(),
                "-P",
                "-F",
                "#{pane_id}",
                hud_command,
            ],
            capture_output=True,
            text=True,
            check=True,
        )
        hud_pane = result.stdout.strip()
        # Mark the HUD pane so scroll-wheel bindings can identify it.
        subprocess.run(
            ["tmux", "set-option", "-p", "-t", hud_pane, "@is_hud", "1"],
            check=False,
        )
        # HUD pane must not capture the scroll wheel.
        subprocess.run(
            [
                "tmux", "bind-key", "-T", "root", "WheelUpPane",
                "if-shell", "-F", "-t", "=",
                "#{e|!=:#{@is_hud},1}",
                "copy-mode -e",
            ],
            check=False,
        )
        ready_path.touch(mode=0o600)
        layout_ready = True
        subprocess.run(["tmux", "select-pane", "-t", main_pane], check=False)
        attach_code = subprocess.call(["tmux", "attach-session", "-t", session_name])
        if _tmux_session_exists(session_name):
            # A zero-code attach that leaves a live session is a normal user
            # detach. The in-session owner keeps Codex and HUD running.
            _best_effort(_write_private_text, detached_path, "1\n")
            return attach_code
        try:
            return int(exit_path.read_text(encoding="utf-8").strip())
        except (FileNotFoundError, OSError, ValueError):
            return attach_code
    except BaseException:
        if not layout_ready or _tmux_session_exists(session_name):
            _kill_tmux("session", session_name)
        raise
    finally:
        session_alive = _tmux_session_exists(session_name)
        if not layout_ready or not session_alive:
            _unlink(ready_path)
        if not session_alive:
            _mark_ended(run_id)
            _remove_run(run_id)
            _unlink(exit_path)
            _unlink(detached_path)


def run_main(
    session_name: str,
    run_id: str,
    ready_file: str,
    exit_file: str,
    detached_file: str,
    arguments: list[str],
) -> int:
    environment = os.environ.copy()
    environment["CODEX_HUD_RUN_ID"] = run_id
    exit_code = 1
    try:
        deadline = time.monotonic() + 10
        while not Path(ready_file).exists():
            if time.monotonic() >= deadline:
                print("Codex HUD：面板启动超时。", file=sys.stderr)
                return 1
            time.sleep(0.05)
        _unlink(Path(ready_file))
        exit_code = subprocess.call(["codex", *arguments], env=environment)
        return exit_code
    finally:
        exit_path = Path(exit_file)
        detached_path = Path(detached_file)
        if not detached_path.exists():
            _best_effort(_write_private_text, exit_path, f"{exit_code}\n")
        _mark_ended(run_id)
        _remove_run(run_id)
        _unlink(Path(ready_file))
        _kill_tmux("session", session_name)
        if detached_path.exists():
            _unlink(exit_path)
        _unlink(detached_path)


def main() -> int:
    parser = argparse.ArgumentParser(prog="codex-hud")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("on", help="启用多行 HUD")
    subparsers.add_parser("off", help="关闭多行 HUD")
    subparsers.add_parser("toggle", help="切换 HUD 开关")
    subparsers.add_parser("status", help="显示 HUD 状态")
    run_parser = subparsers.add_parser("run", help="在 HUD 布局中启动 Codex")
    run_parser.add_argument("arguments", nargs=argparse.REMAINDER)
    internal = subparsers.add_parser("_run-main", help=argparse.SUPPRESS)
    internal.add_argument("--session", required=True)
    internal.add_argument("--run-id", required=True)
    internal.add_argument("--ready-file", required=True)
    internal.add_argument("--exit-file", required=True)
    internal.add_argument("--detached-file", required=True)
    internal.add_argument("arguments", nargs=argparse.REMAINDER)
    args = parser.parse_args()

    if args.command == "on":
        set_enabled(True)
        print("Codex HUD：已开启。使用 `codex-hud run` 启动。")
        return 0
    if args.command == "off":
        set_enabled(False)
        print("Codex HUD：已关闭。现有 HUD 面板会自动退出。")
        return 0
    if args.command == "toggle":
        set_enabled(not enabled())
        print(f"Codex HUD：{'已开启' if enabled() else '已关闭'}。")
        return 0
    if args.command == "status":
        tmux_status = shutil.which("tmux") or "未安装"
        print(f"Codex HUD：{'已开启' if enabled() else '已关闭'}")
        print(f"tmux：{tmux_status}")
        print("账号范围：当前 CODEX_HOME 的当前账号")
        return 0
    if args.command == "run":
        arguments = args.arguments[1:] if args.arguments[:1] == ["--"] else args.arguments
        return launch(arguments)
    if args.command == "_run-main":
        arguments = args.arguments[1:] if args.arguments[:1] == ["--"] else args.arguments
        return run_main(
            args.session,
            args.run_id,
            args.ready_file,
            args.exit_file,
            args.detached_file,
            arguments,
        )
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
